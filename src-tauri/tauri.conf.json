{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 工作台",
  "version": "0.1.0",
  "identifier": "local.personalworkbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "AI 工作台", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 620 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": false, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "resources": {
      "resources/session-reader.mjs": "session-reader.mjs",
      "../node_modules/@anthropic-ai/claude-agent-sdk/sdk.mjs": "claude-sdk.mjs",
      "../node_modules/@anthropic-ai/claude-agent-sdk/LICENSE.md": "claude-sdk-LICENSE.md"
    }
  }
}
